{
  "name": "anquan-server-web",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:webhooks": "node --test tests/webhook-test.test.mjs",
    "test:templates": "node --test tests/agent-template.test.mjs",
    "test:security": "node --test tests/security-profile.test.mjs",
    "test:event-policy": "node --test tests/event-policy.test.mjs",
    "test:downloads": "node --test tests/package-downloads.test.mjs",
    "test:updates": "node --test tests/agent-updates.test.mjs",
    "test:component-status": "node --test tests/component-status.test.mjs",
    "test:events": "node --test tests/events.test.mjs",
    "test:file-snapshots": "node --test tests/file-snapshots.test.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 10111"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.0"
  }
}
